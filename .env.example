# Gemini — https://aistudio.google.com/apikey
# Server-only (used by /api/chat). Never expose to the browser.
# Local live CV test: add key here, then `npm run test:cv-live`
# On Vercel: Project → Settings → Environment Variables → Production+Preview → Redeploy
# Health check: GET /api/health/ai
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional: extra keys from OTHER Google Cloud projects (comma-separated). Same-project keys share quota.
# GOOGLE_GENERATIVE_AI_API_KEYS=
# Model id for new Google AI projects (default: gemini-flash-latest)
# GEMINI_MODEL=gemini-flash-latest

# Auth.js / Google OAuth — auto-enabled when credentials + AUTH_SECRET are set.
# Set GOOGLE_AUTH_ENABLED=false to force-disable Google sign-in.
# Local: copy AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET from Vercel Production,
# set AUTH_URL=http://localhost:3000, and add
# http://localhost:3000/api/auth/callback/google in Google Cloud OAuth client.
GOOGLE_AUTH_ENABLED=
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=http://localhost:3000

# Test login — Unset = on in local/dev, off in production. Set true/false to force.
# Local landings show the dialog; production uses /demo only.
ALLOW_TEST_LOGIN=

# Set true only for local/dev demo API bypass (seed demo-employee / demo-employer)
ALLOW_DEMO=false

# Supabase — https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy anon JWT still works during migration; prefer publishable key above
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Direct Postgres (Settings → Database → Connection string → URI)
# Optional in local dev: when unset, an in-memory store is used automatically.
DATABASE_URL=

# Optional: server-side elevated access (Edge Functions / admin scripts only)
# SUPABASE_SECRET_KEY=
